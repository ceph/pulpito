FROM registry.access.redhat.com/ubi9/python-311

WORKDIR /opt/pulpito
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1

USER 0
# Apply RHEL security updates the ubi9/python-311 base has not been rebuilt with
# (ca-certificates 2026.2.92, CVE-2026-114406).
RUN dnf -y update && dnf clean all

COPY requirements.txt .
RUN python -m pip install -U pip setuptools wheel \
 && python -m pip install -r requirements.txt

COPY . /opt/pulpito

RUN cp /opt/pulpito/config.py.in /opt/pulpito/prod.py

# optional: if you still want install; OK as root
RUN python -m pip install . || true

RUN chgrp -R 0 /opt/pulpito && chmod -R g=u /opt/pulpito

EXPOSE 8081
CMD ["python", "run.py"]
